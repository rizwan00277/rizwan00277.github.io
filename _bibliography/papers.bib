@misc{rizwan2026dualzed,
  title        = {{Real-Time Multi-Robot Tracking and Global Localization Using Dual Stereo Cameras}},
  author       = {Rizwan, Muhammad},
  year         = {2026},
  note         = {Manuscript in preparation},
  abbr         = {In Prep.},
  preview      = {multi_camera_tracking.png},
  selected     = {true},
  abstract     = {We present a multi-camera system that localizes and tracks multiple TurtleBot 4 robots in a shared 8 x 4 m arena. Two fixed ZED 2i stereo cameras are calibrated into a common world frame; YOLO detections are lifted to 3D using stereo depth and fused across cameras with Hungarian assignment, giving each robot a stable identity and a global (x, y) position in real time.}
}

